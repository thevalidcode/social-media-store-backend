model Faq {
  id        Int      @map("id")
  question  String
  answer    String
  status    String   @default("active")
  position  Int
  slug      String
  uid       String   @id
  storeId   Int      @map("store_id")
  timestamp DateTime @default(now())

  // Relations
  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("faqs")
}