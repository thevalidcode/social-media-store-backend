model EmailTemplate {
  id        Int      @map("id")
  uid       String   @id
  type      String
  content   String
  storeId   Int      @map("store_id")
  timestamp DateTime @default(now())

  // Relations
  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("email_templates")
}