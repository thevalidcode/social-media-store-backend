model SessionCode {
  code       String   @id
  email      String
  storeId    Int      @map("store_id")
  store      Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  used       Boolean  @default(false)

  @@map("session_codes")
}
