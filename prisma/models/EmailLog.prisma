model EmailLog {
  id             Int     @id @default(autoincrement())
  storeScopedId   Int     @map("store_scoped_id")
  uid       String   @unique
  sender    String
  receiver  String
  subject   String
  html      String
  status    String
  messageId String?  @map("message_id")
  response  String?
  storeId    Int      @map("store_id")
  store      Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@unique([storeId, storeScopedId])
  @@map("email_logs")
}