enum AdminStatus {
  ACTIVE      @map("active")
  INACTIVE    @map("inactive")
  BANNED      @map("banned")
}

enum AdminRole {
  SUPER              @map("super")
  BASIC              @map("basic")
  MANAGER            @map("manager")
  SUPPORTSTAFF       @map("support_staff")
  FINANCEOFFICER     @map("finance_officer")
  SERVICEOPERATOR    @map("service_operator")
}

model Admin {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  email     String
  image     String?
  password  String
  username  String
  apiKey    String   @unique @map("api_key")
  role      AdminRole   @default(BASIC)
  status    AdminStatus @default(ACTIVE)
  storeId    Int      @map("store_id")
  store      Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  timestamp DateTime @default(now())
  lastSeen  DateTime @default(now()) @map("last_seen")

  @@map("admins")
}