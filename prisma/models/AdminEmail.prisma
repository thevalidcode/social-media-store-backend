model AdminEmail {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  emails    String[]
  storeId    Int      @map("store_id")
  store      Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@map("admins_emails")
}