model AdminEmail {
  id        Int      @id @default(autoincrement())
  uid       String   @unique
  emails    String[]
  storeId   Int      @map("store_id")
  timestamp DateTime @default(now())

  // Relations
  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("admins_emails")
}