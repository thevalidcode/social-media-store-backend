enum StoreStatus {
  ACTIVE      @map("active")
  INACTIVE    @map("inactive")
  DISABLED    @map("disabled")
}

enum StorePlan {
  FREE          @map("free")
  STARTER       @map("starter")
  ESSESENTIALS  @map("essesentials")
  PRO           @map("pro")
  BUSINESS      @map("business")
  EMPIRE        @map("empire")
}

model Store {
  storeId   Int        @id @map("store_id")
  uid       String      @unique
  ssl       Boolean     @default(false)
  plan      StorePlan   @default(FREE)
  status    StoreStatus @default(ACTIVE)
  timestamp DateTime    @default(now())

  // Relations
  User             User[]
  Admin            Admin[]
  Service          Service[]
  Order            Order[]
  AdminEmail       AdminEmail[]
  AffiliateSetting AffiliateSetting[]
  Blog             Blog[]
  Category         Category[]
  DesignStyle      DesignStyle[]
  EmailLog         EmailLog[]
  EmailTemplate    EmailTemplate[]
  Faq              Faq[]
  General          General[]
  SessionCode      SessionCode[]
  Provider         Provider[]
  Refill           Refill[]
  UploadLog        UploadLog[]
  Transaction      Transaction[]
  ReferralOrder    ReferralOrder[]
  
  storeCounter     StoreCounter?
  
  @@map("stores")
}