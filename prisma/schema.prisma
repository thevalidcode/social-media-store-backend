generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Store {
  storeId     Int         @id @map("store_id")
  uid         String      @unique // Store domain e.g validpanel.com
  ssl         Boolean     @default(false)
  timestamp   DateTime    @default(now())
  status      StoreStatus
  description String?
  name        String

  Admin            Admin[]
  AdminEmail       AdminEmail[]
  AffiliateSetting AffiliateSetting[]
  Blog             Blog[]
  Cancel           Cancel[]
  Category         Category[]
  DesignStyle      DesignStyle[]
  EmailLog         EmailLog[]
  EmailTemplate    EmailTemplate[]
  Faq              Faq[]
  Order            Order[]
  Page             Page[]
  PaymentGateway   PaymentGateway[]
  Payment          Payment[]
  Provider         Provider[]
  ReferralOrder    ReferralOrder[]
  Refill           Refill[]
  Service          Service[]
  ServiceRating    ServiceRating[]
  SessionCode      SessionCode[]
  Setting          Setting[]
  storeCounter     StoreCounter?
  SupportTicket    SupportTicket[]
  Transaction      Transaction[]
  UploadLog        UploadLog[]
  User             User[]

  @@map("stores")
}

model User {
  id               Int        @id @default(autoincrement())
  storeScopedId    Int        @map("store_scoped_id")
  refCode          Int?       @unique @default(autoincrement()) @map("ref_code")
  uid              String     @unique
  email            String
  image            String?
  password         String
  username         String
  encryptedApiKey  String?    @map("encrypted_api_key")
  apiKeyIv         String?    @map("api_key_iv")
  apiKeyHash       String?    @unique @map("api_key_hash")
  storeId          Int        @map("store_id")
  balance          Decimal    @default(0.00) @db.Decimal(10, 2)
  spent            Decimal    @default(0.00) @db.Decimal(10, 2)
  timestamp        DateTime   @default(now())
  lastSeen         DateTime   @default(now()) @map("last_seen")
  currency         String     @default("USD")
  ref              Int?
  role             UserRole   @default(BASIC)
  status           UserStatus @default(ACTIVE)
  fullName         String?
  resetToken       String?    @map("reset_token")
  resetTokenExpiry DateTime?  @map("reset_token_expiry")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  Order         Order[]
  Payment       Payment[]
  SupportTicket SupportTicket[]
  transactions  Transaction[]
  referredBy    User?           @relation("Referral", fields: [ref], references: [refCode])
  referrals     User[]          @relation("Referral")
  store         Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@unique([email, storeId])
  @@unique([username, storeId])
  @@map("users")
}

// This Admin model is the user in the core-platform, that's why most fields aren't unique.
model Admin {
  id                  Int
  uid                 String
  email               String
  image               String?
  password            String
  username            String
  encryptedApiKey     String?     @map("encrypted_api_key")
  apiKeyIv            String?     @map("api_key_iv")
  apiKeyHash          String?     @unique @map("api_key_hash")
  storeId             Int         @unique @map("store_id")
  timestamp           DateTime    @default(now())
  lastSeen            DateTime    @default(now()) @map("last_seen")
  role                AdminRole   @default(BASIC)
  status              AdminStatus @default(ACTIVE)
  currency            String      @default("USD")
  fullName            String?     @map("full_name")
  onboardingCompleted Boolean?    @default(false) @map("onboarding_completed")
  resetToken          String?     @map("reset_token")
  resetTokenExpiry    DateTime?   @map("reset_token_expiry")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("admins")
}

model Service {
  id               Int           @id @default(autoincrement())
  storeScopedId    Int           @map("store_scoped_id")
  uid              String        @unique @default(uuid())
  name             String
  description      String?
  category         String
  categoryUid      String        @map("category_uid")
  min              Int           @default(1)
  max              Int           @default(1)
  position         Int           @default(1)
  providerId       Int?          @map("provider_id")
  providerPrice    Decimal?      @map("provider_price") @db.Decimal(10, 2)
  storeId          Int           @map("store_id")
  timestamp        DateTime      @default(now())
  syncQuantity     Boolean?      @default(true) @map("sync_quantity")
  syncCatAndName   Boolean?      @default(true) @map("sync_cat_and_name")
  cancel           Boolean?
  network          String?
  refill           Boolean?
  percentage       Float?
  syncWithProvider Boolean       @default(true)
  currency         String?
  dripFeed         Boolean?      @default(false) @map("drip_feed")
  providerCurrency String?       @map("provider_currency")
  refillDays       Int?          @map("refill_days")
  price            Decimal       @default(0.00) @db.Decimal(10, 2)
  status           ServiceStatus @default(ACTIVE)
  type             ServiceType   @default(DEFAULT)
  icon             String?
  providerUid      String?       @map("provider_uid")

  Order         Order[]
  ServiceRating ServiceRating[]
  provider      Provider?       @relation(fields: [providerUid], references: [uid], onDelete: Cascade)
  categoryData  Category        @relation(fields: [categoryUid], references: [uid], onDelete: Cascade)
  store         Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("services")
}

model ServiceRating {
  id            Int          @id @default(autoincrement())
  storeScopedId Int          @map("store_scoped_id")
  uid           String       @unique @default(uuid())
  serviceUid    String       @map("service_uid")
  userUid       String       @map("user_uid")
  rating        Int // 1-5 stars
  review        String?
  status        RatingStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  timestamp     DateTime     @default(now())
  storeId       Int          @map("store_id")

  service Service @relation(fields: [serviceUid], references: [uid], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@unique([serviceUid, userUid, storeId]) // One rating per user per service per store
  @@map("service_ratings")
}

model Order {
  id                 Int         @id @default(autoincrement())
  storeScopedId      Int         @map("store_scoped_id")
  uid                String      @unique @default(uuid())
  timestamp          DateTime    @default(now())
  userUid            String      @map("user_uid")
  currency           String      @default("USD")
  syncOrder          Boolean     @default(false) @map("sync_order")
  synced             Boolean     @default(false)
  providerCurrency   String?     @map("provider_currency")
  providerPrice      Decimal?    @map("provider_price") @db.Decimal(10, 2)
  providerOrderId    Int?        @map("provider_order_id")
  provider           String?
  providerError      String?     @map("provider_error")
  quantity           Int
  retryCount         Int?        @map("retry_count")
  url                String
  lastRunTime        DateTime?   @map("last_run_time")
  comments           String      @default("")
  dripFeed           Boolean     @default(false) @map("drip_feed")
  interval           Int?        @default(0)
  runs               Int?        @default(0)
  processedRuns      Int?        @default(0) @map("processed_runs")
  start              Int         @default(0)
  userInitialBalance Decimal     @default(0.00) @map("user_initial_balance") @db.Decimal(10, 2)
  userFinalBalance   Decimal     @default(0.00) @map("user_final_balance") @db.Decimal(10, 2)
  price              Decimal     @default(0.00) @db.Decimal(10, 2)
  remains            Int         @default(0)
  storeId            Int         @map("store_id")
  serviceUid         String      @map("service_uid")
  paymentUid         String?     @unique @map("payment_uid")
  status             OrderStatus @default(PENDING)
  service            Service     @relation(fields: [serviceUid], references: [uid], onDelete: Cascade)
  store              Store       @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  user               User        @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  payment            Payment?    @relation(fields: [paymentUid], references: [uid], onDelete: SetNull)
  cancels            Cancel[]

  @@unique([storeId, storeScopedId])
  @@map("orders")
}

model AdminEmail {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  emails    String[]
  storeId   Int      @unique @map("store_id")
  timestamp DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("admins_emails")
}

model AffiliateSetting {
  id      Int    @map("id")
  uid     String @id @default(uuid())
  percent Int
  mode    String @default("percentage")
  storeId Int    @map("store_id")
  store   Store  @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("affiliate_settings")
}

model Blog {
  id            Int        @id @default(autoincrement())
  storeScopedId Int        @map("store_scoped_id")
  title         String
  content       String
  position      Int
  slug          String
  uid           String     @unique @default(uuid())
  storeId       Int        @map("store_id")
  coverImage    String     @default("") @map("cover_image")
  status        BlogStatus @default(ACTIVE)
  excerpt       String
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  store         Store      @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("blogs")
}

model Cancel {
  id              Int          @id @default(autoincrement())
  storeScopedId   Int          @map("store_scoped_id")
  uid             String       @unique @default(uuid())
  timestamp       DateTime     @default(now())
  userUid         String       @map("user_uid")
  providerUid     String       @map("provider_id")
  status          CancelStatus @default(PENDING)
  providerOrderId Int          @map("provider_order_id")
  orderUid        String       @map("order_uid")
  providerError   String?      @map("provider_error")
  storeId         Int          @map("store_id")

  store    Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  provider Provider @relation(fields: [providerUid], references: [uid], onDelete: Cascade)
  order    Order    @relation(fields: [orderUid], references: [uid], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@unique([orderUid, status]) // Only one PENDING cancel per order
  @@map("cancels")
}

model Category {
  id            Int            @id @default(autoincrement())
  storeScopedId Int            @map("store_scoped_id")
  name          String
  timestamp     DateTime       @default(now())
  description   String         @default("")
  position      Int
  uid           String         @unique @default(uuid()) @map("uid")
  storeId       Int            @map("store_id")
  status        CategoryStatus @default(ACTIVE)
  icon          String?
  store         Store          @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  services      Service[]

  @@unique([storeId, storeScopedId])
  @@map("categories")
}

model DesignStyle {
  id            Int     @id @default(autoincrement())
  storeScopedId Int     @map("store_scoped_id")
  uid           String  @unique @default(uuid())
  storeId       Int     @map("store_id")
  hex           String
  schema        Json
  name          String?
  store         Store   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("design_styles")
}

model EmailLog {
  id            Int         @id @default(autoincrement())
  storeScopedId Int         @map("store_scoped_id")
  uid           String      @unique @default(uuid())
  sender        String
  receiver      String
  subject       String
  html          String
  status        EmailStatus
  messageId     String?     @map("message_id")
  response      String?
  storeId       Int         @map("store_id")
  timestamp     DateTime    @default(now())
  store         Store       @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("email_logs")
}

model EmailTemplate {
  id            Int      @id @default(autoincrement())
  storeScopedId Int      @map("store_scoped_id")
  uid           String   @unique @default(uuid())
  content       String // HTML template with {{variables}}
  name          String? // human-readable name
  storeId       Int      @map("store_id")
  subject       String // optional default subject
  type          String // e.g., "PASSWORD_RESET", "WELCOME_USER"
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  store         Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("email_templates")
}

model Faq {
  id            Int       @id @default(autoincrement())
  storeScopedId Int       @map("store_scoped_id")
  question      String
  answer        String
  position      Int
  slug          String
  uid           String    @unique @default(uuid())
  storeId       Int       @map("store_id")
  timestamp     DateTime  @default(now())
  status        FaqStatus @default(ACTIVE)
  store         Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("faqs")
}

model Page {
  id            Int        @id @default(autoincrement())
  storeScopedId Int        @map("store_scoped_id")
  uid           String     @unique @default(uuid())
  title         String
  content       String
  description   String?
  pageType      PageType   @map("page_type")
  status        PageStatus @default(ACTIVE)
  storeId       Int        @map("store_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  store         Store      @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@unique([storeId, pageType])
  @@map("pages")
}

model Setting {
  id                    Int      @id @default(autoincrement())
  uid                   String   @unique @default(uuid())
  storeId               Int      @unique @map("store_id")
  storeName             String   @default("My Store") @map("store_name")
  storeDescription      String?  @map("store_description")
  logoUrl               String?  @map("logo_url")
  faviconUrl            String?  @map("favicon_url")
  defaultClientCurrency String?  @map("default_client_currency")
  showBanner            Boolean? @default(true) @map("show_banner")
  onboardingCompleted   Boolean? @default(false) @map("onboarding_completed")

  // Social Accounts
  instagramUrl String?
  facebookUrl  String?
  youtubeUrl   String?
  xUrl         String?
  tiktokUrl    String?

  // Store Physical Address
  storeStreet     String? @map("store_street")
  storeCity       String? @map("store_city")
  storeState      String? @map("store_state")
  storePostalCode String? @map("store_postal_code")
  storeCountry    String? @map("store_country")
  storePhone      String? @map("store_phone")

  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("settings")
}

model InternalApiSession {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  data      Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("internal_api_sessions")
}

model PaymentGateway {
  id            Int                    @id @default(autoincrement())
  storeScopedId Int                    @map("store_scoped_id")
  uid           String                 @unique @default(uuid())
  name          String
  description   String?
  content       String?
  secretKey     Json?                  @map("secret_key")
  createdAt     DateTime               @default(now()) @map("created_at")
  storeId       Int                    @map("store_id")
  min           Decimal                @db.Decimal(10, 2)
  max           Decimal                @db.Decimal(10, 2)
  currency      String                 @default("USD")
  position      Int                    @map("position")
  status        PaymentGatewayStatus   @default(ACTIVE)
  platform      PaymentGatewayPlatform @default(MANUAL)
  signature     String?
  webhookUrl    String?                @map("webhook_url")
  feePercent    Int?                   @default(0) @map("fee_percent")
  store         Store                  @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("payment_gateways")
}

model Provider {
  id            Int       @id @default(autoincrement())
  storeScopedId Int       @map("store_scoped_id")
  uid           String    @unique @default(uuid())
  name          String
  url           String
  sync          Boolean   @default(false)
  percentage    Float     @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")
  isInternal    Boolean   @default(false) @map("is_internal")
  storeId       Int       @map("store_id")
  currency      String    @default("USD")
  apiKey        Json      @map("api_key")
  image         String    @default("https://cdn-icons-png.flaticon.com/512/1/1.png") // Default icon if not provided
  store         Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  Service       Service[]
  cancels       Cancel[]

  @@unique([storeId, storeScopedId])
  @@map("providers")
}

model ReferralOrder {
  id            Int      @id @default(autoincrement())
  storeScopedId Int      @map("store_scoped_id")
  uid           String   @unique @default(uuid())
  refId         Int      @unique @map("ref_id")
  timestamp     DateTime @default(now())
  username      String
  currency      String   @default("USD")
  price         Decimal  @default(0.00) @db.Decimal(10, 2)
  storeId       Int      @map("store_id")
  store         Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("referral_orders")
}

model Refill {
  id              Int          @id @default(autoincrement())
  storeScopedId   Int          @map("store_scoped_id")
  uid             String       @unique @default(uuid())
  timestamp       DateTime     @default(now())
  userUid         String       @map("user_uid")
  providerId      Int          @map("provider_id")
  providerOrderId Int          @map("provider_order_id")
  provider        String
  providerError   String?      @map("provider_error")
  storeId         Int          @map("store_id")
  status          RefillStatus @default(PENDING)
  orderUid        String       @map("order_uid")
  store           Store        @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("refills")
}

model SessionCode {
  code      String   @id
  email     String
  storeId   Int      @map("store_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  store     Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("session_codes")
}

model StoreCounter {
  storeId               Int   @id @map("store_id")
  serviceCounter        Int   @default(0) @map("service_counter")
  orderCounter          Int   @default(0) @map("order_counter")
  blogCounter           Int   @default(0) @map("blog_counter")
  faqCounter            Int   @default(0) @map("faq_counter")
  pageCounter           Int   @default(0) @map("page_counter")
  categoryCounter       Int   @default(0) @map("category_counter")
  userCounter           Int   @default(0) @map("user_counter")
  emailLogCounter       Int   @default(0) @map("email_log_counter")
  emailTemplateCounter  Int   @default(0) @map("email_template_counter")
  uploadLogCounter      Int   @default(0) @map("upload_log_counter")
  providerCounter       Int   @default(0) @map("provider_counter")
  refillCounter         Int   @default(0) @map("refill_counter")
  transactionCounter    Int   @default(0) @map("transaction_counter")
  referralOrderCounter  Int   @default(0) @map("referral_order_counter")
  paymentGatewayCounter Int   @default(0) @map("payment_gateway_counter")
  supportTicketCounter  Int   @default(0) @map("support_ticket_counter")
  cancelCounter         Int   @default(0) @map("cancel_counter")
  paymentCounter        Int   @default(0) @map("payment_counter")
  ratingCounter         Int   @default(0) @map("rating_counter")
  store                 Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("store_counters")
}

model SupportTicket {
  id            Int             @id @default(autoincrement())
  uid           String          @unique @default(uuid())
  storeId       Int             @map("store_id")
  userUid       String          @map("user_uid")
  storeScopedId Int             @map("store_scoped_id")
  subject       String
  status        TicketStatus    @default(OPEN)
  priority      TicketPriority  @default(MEDIUM)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  description   String?
  store         Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  user          User            @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  messages      TicketMessage[] @relation("TicketMessages")

  @@unique([storeId, storeScopedId])
  @@index([storeId])
  @@index([userUid])
  @@map("support_tickets")
}

model TicketMessage {
  id         Int               @id @default(autoincrement())
  uid        String            @unique @default(uuid())
  ticketUid  String            @map("ticket_uid")
  senderUid  String            @map("sender_uid")
  senderType MessageSenderType @map("sender_type")
  message    String
  createdAt  DateTime          @default(now()) @map("created_at")
  ticket     SupportTicket     @relation("TicketMessages", fields: [ticketUid], references: [uid], onDelete: Cascade)

  @@index([ticketUid])
  @@index([senderUid])
  @@map("ticket_messages")
}

model Transaction {
  id            Int             @id @default(autoincrement())
  storeScopedId Int             @map("store_scoped_id")
  uid           String          @unique @default(uuid())
  amount        Decimal         @db.Decimal(10, 2)
  timestamp     DateTime        @default(now())
  currency      String          @default("USD")
  userUid       String          @map("user_uid")
  storeId       Int             @map("store_id")
  description   String
  type          TransactionType
  store         Store           @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  user          User            @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("transactions")
}

model Payment {
  id            Int                    @id @default(autoincrement())
  uid           String                 @unique @default(uuid())
  userUid       String                 @map("user_id")
  currency      String
  amount        Decimal                @db.Decimal(10, 2)
  chargedAmount Decimal                @map("charged_amount") @db.Decimal(10, 2)
  status        PaymentStatus
  purpose       PaymentPurpose         @default(WALLET_TOPUP)
  method        PaymentGatewayPlatform
  createdAt     DateTime               @default(now()) @map("created_at")
  storeId       Int                    @map("store_id")
  storeScopedId Int
  store         Store                  @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  user          User                   @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  order         Order?

  @@unique([storeId, storeScopedId])
  @@map("payments")
}

model UploadLog {
  id            Int      @id @default(autoincrement())
  storeScopedId Int      @map("store_scoped_id")
  uid           String   @unique @default(uuid())
  size          Int
  url           String
  collection    String
  filename      String
  mimetype      String
  storeId       Int      @map("store_id")
  timestamp     DateTime @default(now())
  store         Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([storeId, storeScopedId])
  @@map("upload_logs")
}

enum StoreStatus {
  ACTIVE
  CANCELED
  DISABLED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserRole {
  BASIC
  VIP
  RESELLER
  PARTNER
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum EmailStatus {
  SUCCESS
  ERROR
}

enum AdminRole {
  SUPER
  BASIC
  MANAGER
  SUPPORT_STAFF
  FINANCE_OFFICER
  SERVICE_OPERATOR
}

enum ServiceStatus {
  ACTIVE
  DISABLED
}

enum ServiceType {
  MANUAL
  DEFAULT
  PACKAGE
  SEO
  CUSTOM_COMMENTS
  MENTIONS
  MENTIONS_WITH_HASHTAGS
  MENTIONS_CUSTOM_LIST
  MENTIONS_HASHTAG
  MENTIONS_USER_FOLLOWERS
  MENTIONS_MEDIA_LIKERS
  CUSTOM_COMMENTS_PACKAGE
  COMMENT_LIKES
  POLL
  COMMENT_REPLIES
  SUBSCRIPTIONS
